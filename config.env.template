# Configuração do educability-annotator na DGX. Copie para config.env e ajuste.
# Explicações das escolhas ficam em docs/dgx.md e no Projetos/PLANO_EDUCABILIDADE.md.

# === PROJETO ===

# Nome usado em containers, labels e scratches
PROJECT_NAME=educability-annotator

# Raiz do repositório no NFS (código, relatórios)
PROJECT_DIR=/home/${USER}/Projetos/educability-annotator

# === DADOS (NVMe do nó de computação) ===

# Corpus de entrada (cpt-corpus) e versão
CPT_DATA_ROOT=/output/${USER}/cpt-corpus
CPT_VERSION=v1

# Rótulos laterais (saída), um diretório por modelo e revisão dentro deste
EDU_LABELS_ROOT=${CPT_DATA_ROOT}/labels/${CPT_VERSION}

# Piloto por fonte (FASE 3): amostra com os textos e os rótulos da amostra
EDU_PILOT_ROOT=${EDU_LABELS_ROOT}/pilot

# Decisões do dedup cujos documentos não são anotados (globs relativos a CPT_DATA_ROOT, separados por espaço).
# O * do meio pega o exato e o fuzzy (mesmo layout, combinado com a sessão da deduplicação em 21/10)
EDU_EXCLUDE="dedup/${CPT_VERSION}/*/decisions/source=*/decisions.parquet"

# Tag do modelo no nome dos diretórios de rótulos
EDU_MODEL_TAG=educability-mini-6a114f1

# Repositório do cpt-corpus no NFS e os arquivos dele de que o relatório do piloto tira os tokens Qwen3
# por fonte (relativos ao repositório): conferências da ingestão e antes/depois do exato
CPT_PROJECT_DIR=/home/${USER}/Projetos/cpt-corpus
CPT_INGEST_CHECKS="reports/ingest/check_12363.json reports/ingest/check_12548.json"
CPT_BEFORE_AFTER=logs/dev/before_after.jsonl

# Cache do Hugging Face no NVMe: o 01_check_env baixa o modelo uma vez e a inferência roda offline
EDU_HF_HOME=/output/${USER}/hf-cache

# Onde cada job cria o seu scratch (educability-annotator_<jobid>)
SCRATCH_BASE=/output/${USER}

# Idade mínima, em minutos, para um scratch sem job ativo ser considerado órfão
CLEANUP_MIN_AGE_MIN=60

# === SLURM ===

# Partição (o cluster só tem a dgx)
SLURM_PARTITION=dgx

# === MODELO ===

# Classificador e revisão fixada (a do manifesto da ferramenta)
EDU_MODEL=gregassagraf/educability-norberto-mini-4class-v1
EDU_MODEL_REVISION=6a114f1c8c43191137efe3e75f15e0d7af1ba292

# === IMAGENS ===

# Base CUDA, a mesma da imagem do Curator 1.4.0 do cpt-corpus (já presente no nó), fixada por digest
EDU_BASE_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu24.04@sha256:020bc241a628776338f4d4053fed4c38f6f7f3d7eb5919fecb8de313bb8ba47c

# Versão do uv usada no build e na geração do lock
UV_VERSION=0.12.1

# Alvo toolchain do docker/Dockerfile (Python 3.12 + uv): gera o docker/requirements.gpu.lock
EDU_TOOLCHAIN_IMAGE=educability-annotator-toolchain:uv-0.12.1

# Alvo runtime (lock + flash-attn); mude a tag sempre que o lock ou o Dockerfile mudarem
EDU_IMAGE=educability-annotator:0.1.0-dgx.1

# FlashAttention-2 pré-compilado (CUDA 12, torch 2.7, Python 3.12); o build escolhe a variante de ABI do torch
FLASH_ATTN_VERSION=2.8.3
FLASH_ATTN_SHA256_ABI_TRUE=cafd4f708725e1be95495a86cbf418cfada08e707c8a797def61488a2a3c4f72
FLASH_ATTN_SHA256_ABI_FALSE=425b1068cf5b8c916d09cc4ee21c9a102d9b3f83851cf8555cb8aa89265a52df

# === GPU ===

# GPUs do nosso turno, por índice; o número de GPUs sai daqui, nunca de valor fixo nos scripts
EDU_GPU_POOL=0,1,2,3,4,5,6,7

# === CREDENCIAIS ===

# Arquivo que define HF_TOKEN (fora de qualquer repositório); o modelo é público, os juízes podem não ser
SECRETS_FILE=${HOME}/.secrets/tokens
